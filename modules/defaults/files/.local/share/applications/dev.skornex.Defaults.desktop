[Desktop Entry]
# SkorneX Settings module (defaults). Named after the window's app ID so the
# taskbar and title bar find its icon.
Type=Application
Name=Default apps
Comment=Which app opens web links, folders, text, pictures, videos, music, PDFs and zip files.
Exec=skornex-defaults
Icon=preferences-desktop-default-applications
StartupWMClass=dev.skornex.Defaults
Categories=Settings;
Keywords=default;apps;applications;browser;open with;file types;
