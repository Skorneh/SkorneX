#!/usr/bin/env python3
"""SkorneX Sound settings: output and input devices, their volume, and the
volume of each app that's playing sound, like Windows' Sound settings and
Volume mixer. For the microphone: a boost above 100%, a cap on how loud you
can get (so shouting doesn't blast people in Discord), a live level meter,
and a record-and-play-back test.

    skornex-sound     open it on its own (or search "Sound settings")

It's also a page in Settings (skornex-settings). Everything changes right
away; PipeWire remembers it. The cap is a limiter (swh-plugins) that sits
between your real microphone and apps: "Microphone (volume capped)", which
becomes the default microphone while the cap is on. It runs as its own small
PipeWire process (pipewire -c ~/.config/skornex/mic-cap.conf, started at login
from ~/.config/skornex/autostart.d/mic-cap), so turning it on or off never
restarts the sound system (which cuts apps' sound); moving the cap line
changes the running limiter live.

Only use this microphone (off unless you turn it on): every other sound card
is switched to a profile without its microphone (a webcam's to Off, the
built-in card's to its speakers only), so when yours is unplugged or drops off
USB, apps don't switch to another mic; they pick yours up again when it's
back. It's done live, without restarting anything, so apps keep their sound;
WirePlumber remembers the profiles. Turning it off puts the old profiles back
(saved in sound.json).

Push to talk (off unless you turn it on): the microphone stays muted except
while you hold a key or mouse button, in every app and in games. That's
skornex-ptt, started at login from ~/.config/skornex/autostart.d.
"""

import array
import grp
import json
import math
import os
import subprocess
import sys
import shutil
import tempfile

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, Gio, GLib, Gtk  # noqa: E402

TITLE = "Sound"
ICON = "preferences-desktop-sound"
APP_ID = "dev.skornex.Sound"

STATE = os.path.expanduser("~/.config/skornex/sound.json")
CAP_NODE = "skornex_mic_capped"
CAP_CONF = os.path.expanduser("~/.config/skornex/mic-cap.conf")
CAP_AUTOSTART = os.path.expanduser("~/.config/skornex/autostart.d/mic-cap")
CAP_PROCESS = r"pipewire -c .*/mic-cap\.conf"   # for pkill -f
# Where an earlier version put the cap, inside PipeWire itself.
OLD_CAP_CONF = os.path.expanduser("~/.config/pipewire/pipewire.conf.d/90-skornex-mic-cap.conf")
CAP_TEMPLATE = """# Made by Sound settings (skornex-sound): caps how loud the microphone can get.
# Runs as its own process: pipewire -c ~/.config/skornex/mic-cap.conf
context.properties = {{ log.level = 0 }}
context.spa-libs = {{
  audio.convert.* = audioconvert/libspa-audioconvert
  support.*       = support/libspa-support
}}
context.modules = [
  {{ name = libpipewire-module-rt args = {{ }} flags = [ ifexists nofail ] }}
  {{ name = libpipewire-module-protocol-native }}
  {{ name = libpipewire-module-client-node }}
  {{ name = libpipewire-module-adapter }}
  {{ name = libpipewire-module-filter-chain
    args = {{
      node.description = "Microphone (volume capped)"
      media.name = "Microphone (volume capped)"
      filter.graph = {{
        nodes = [
          {{ type = ladspa
            name = limiter
            plugin = fast_lookahead_limiter_1913
            label = fastLookaheadLimiter
            control = {{ "Input gain (dB)" = {boost:.1f} "Limit (dB)" = {limit:.1f} "Release time (s)" = 0.1 }}
          }}
          {{ type = builtin name = left label = linear control = {{ "Mult" = {undo:.6f} }} }}
          {{ type = builtin name = right label = linear control = {{ "Mult" = {undo:.6f} }} }}
        ]
        links = [
          {{ output = "limiter:Output 1" input = "left:In" }}
          {{ output = "limiter:Output 2" input = "right:In" }}
        ]
        inputs = [ "limiter:Input 1" "limiter:Input 2" ]
        outputs = [ "left:Out" "right:Out" ]
      }}
      audio.channels = 2
      audio.position = [ FL FR ]
      capture.props = {{
        node.name = "capture.{node}"
        node.passive = true
        target.object = "{mic}"
      }}
      playback.props = {{
        node.name = "{node}"
        media.class = Audio/Source
      }}
    }}
  }}
]
"""
# Made by an earlier version of "Only use this microphone"; removed when it's used.
OLD_ONE_MIC_CONF = os.path.expanduser("~/.config/wireplumber/wireplumber.conf.d/90-skornex-one-mic.conf")
PTT = os.path.expanduser("~/.local/bin/skornex-ptt")
PTT_AUTOSTART = os.path.expanduser("~/.config/skornex/autostart.d/push-to-talk")
INPUT_CODES = "/usr/include/linux/input-event-codes.h"
# GTK's mouse button numbers -> Linux's names (4-7 are the scroll wheel).
MOUSE_BUTTONS = {2: ("BTN_MIDDLE", "Middle mouse button"), 8: ("BTN_SIDE", "Mouse back button"),
                 9: ("BTN_EXTRA", "Mouse forward button")}
TEST_SECONDS = 5
LOWEST_CAP = -40  # dB; 0 dB is as loud as a microphone can record


def cap_settings(cap):
    """The limiter can only cap at -20 dB or higher. For a lower cap, the
    voice is boosted before the limiter and turned down the same amount after
    it: quiet sounds come out unchanged, loud ones stop at the cap."""
    boost = max(0.0, -20.0 - cap)
    return {"boost": boost, "limit": cap + boost, "undo": 10 ** (-boost / 20)}


DEFAULT_STATE = {"cap": False, "limit": -6.0, "mic": "", "only_mic": False, "mic_profiles": {},
                 "ptt": False, "ptt_key": "KEY_CAPSLOCK", "ptt_name": "Caps Lock"}


def load_state():
    try:
        with open(STATE) as f:
            return {**DEFAULT_STATE, **json.load(f)}
    except (OSError, ValueError):
        return dict(DEFAULT_STATE)


def save_state(state):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    with open(STATE, "w") as f:
        json.dump(state, f, indent=1)


def pactl(*args):
    try:
        return subprocess.run(["pactl", *args], capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def pactl_json(*args):
    try:
        return json.loads(pactl("-f", "json", *args) or "[]")
    except ValueError:
        return []


def percent(item):
    """Volume of a sink/source/stream as a whole percent (first channel)."""
    for channel in (item.get("volume") or {}).values():
        try:
            return int(str(channel.get("value_percent", "0")).rstrip("%"))
        except ValueError:
            return 0
    return 0


def cap_filter_id():
    """The PipeWire id of the running cap's filter node (where its limiter
    settings live), or None when the cap isn't running."""
    try:
        objects = json.loads(subprocess.run(["pw-dump"], capture_output=True, text=True,
                                            timeout=5).stdout or "[]")
    except (OSError, subprocess.SubprocessError, ValueError):
        return None
    for o in objects:
        props = (o.get("info") or {}).get("props") or {}
        if o.get("type") == "PipeWire:Interface:Node" and props.get("node.name") == "capture." + CAP_NODE:
            return o["id"]
    return None


def set_cap_live(limit):
    """Changes the running limiter's settings. False if it isn't running."""
    node = cap_filter_id()
    if node is None:
        return False
    c = cap_settings(limit)
    params = (f'"limiter:Input gain (dB)" {c["boost"]:.1f} "limiter:Limit (dB)" {c["limit"]:.1f} '
              f'"left:Mult" {c["undo"]:.6f} "right:Mult" {c["undo"]:.6f}')
    subprocess.run(["pw-cli", "set-param", str(node), "Props", f"{{ params = [ {params} ] }}"],
                   capture_output=True)
    return True


def start_cap(now=True):
    """(Re)starts the cap's own PipeWire process, now and at every login."""
    if now:
        subprocess.run(["pkill", "-f", CAP_PROCESS])
    os.makedirs(os.path.dirname(CAP_AUTOSTART), exist_ok=True)
    with open(CAP_AUTOSTART, "w") as f:
        f.write("#!/bin/sh\n# Made by Sound settings: the microphone cap.\n"
                f"exec pipewire -c {CAP_CONF} >> ~/.cache/skornex-mic-cap.log 2>&1\n")
    os.chmod(CAP_AUTOSTART, 0o755)
    if now:
        subprocess.Popen(["sh", CAP_AUTOSTART], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def stop_cap():
    subprocess.run(["pkill", "-f", CAP_PROCESS])
    if os.path.exists(CAP_AUTOSTART):
        os.remove(CAP_AUTOSTART)


def without_mic(card):
    """The profile for card that keeps what it plays through but has no
    microphone ("output:analog-stereo+input:analog-stereo" -> "output:analog-
    stereo"; a webcam's "input:analog-stereo" -> "off"), or None if its
    current profile has no microphone anyway."""
    active = card.get("active_profile") or ""
    if "input:" not in active:
        return None
    outputs = "+".join(part for part in active.split("+") if part.startswith("output:"))
    return outputs if outputs in (card.get("profiles") or {}) else "off"


def only_use_mic(state, mic):
    """Turns off every microphone but mic, or with mic None puts the other
    cards' profiles back. Changes state["mic_profiles"]; the caller saves it."""
    cards = {c["name"]: c for c in pactl_json("list", "cards")}
    old = os.path.exists(OLD_ONE_MIC_CONF)
    if old:
        os.remove(OLD_ONE_MIC_CONF)
    if mic is None:
        for name, profile in state.get("mic_profiles", {}).items():
            if name in cards:
                pactl("set-card-profile", name, profile)
        if old:
            # The earlier version's mics stay off until their card is set up
            # again: switching its profile away and back does that, without
            # restarting WirePlumber (which cuts apps' sound).
            live = {src.get("properties", {}).get("device.name") for src in pactl_json("list", "sources")}
            for name, card in cards.items():
                profile = without_mic(card)
                if profile and name not in live and name not in state.get("mic_profiles", {}):
                    pactl("set-card-profile", name, profile)
                    pactl("set-card-profile", name, card["active_profile"])
        state["mic_profiles"] = {}
        return
    keep = next((src.get("properties", {}).get("device.name") for src in pactl_json("list", "sources")
                 if src["name"] == mic), None)
    for name, card in cards.items():
        if name == keep or not name.startswith("alsa_card."):   # Bluetooth switches by itself
            continue
        profile = without_mic(card)
        if profile:
            state.setdefault("mic_profiles", {}).setdefault(name, card["active_profile"])
            pactl("set-card-profile", name, profile)


def key_names():
    """{58: "KEY_CAPSLOCK", ...}: Linux's key names, which skornex-ptt takes."""
    names = {}
    try:
        with open(INPUT_CODES) as f:
            for line in f:
                parts = line.split()
                if len(parts) >= 3 and parts[0] == "#define" and parts[1].startswith(("KEY_", "BTN_")):
                    try:
                        names.setdefault(int(parts[2], 0), parts[1])  # the first name, not aliases
                    except ValueError:
                        pass
    except OSError:
        pass
    return names


def key_label(key, keyval=None):
    """The name shown for the push-to-talk key, like "Caps Lock": what the
    key types, else Linux's name for it (KEY_CAPSLOCK -> "Caps Lock")."""
    name = Gdk.keyval_name(Gdk.keyval_to_upper(keyval)) if keyval else None
    if name and name != "VoidSymbol" and not name.startswith("0x"):
        return name.replace("_", " ")
    known = {"KEY_CAPSLOCK": "Caps Lock", "KEY_SCROLLLOCK": "Scroll Lock", "KEY_NUMLOCK": "Num Lock",
             "KEY_LEFTCTRL": "Left Ctrl", "KEY_RIGHTCTRL": "Right Ctrl", "KEY_LEFTALT": "Left Alt",
             "KEY_RIGHTALT": "Right Alt", "KEY_LEFTSHIFT": "Left Shift", "KEY_RIGHTSHIFT": "Right Shift",
             "KEY_LEFTMETA": "Windows key", "KEY_RIGHTMETA": "Right Windows key"}
    return known.get(key) or key.split("_", 1)[-1].replace("_", " ").title()


def ptt_problem():
    """What still stands in the way of push to talk, or None."""
    import importlib.util
    if importlib.util.find_spec("evdev") is None:
        return "Push to talk needs python-evdev. Run: sudo pacman -S python-evdev"
    user = os.environ.get("USER") or os.getlogin()
    try:
        group = grp.getgrnam("input")
    except KeyError:
        return "This PC has no input group."
    if user not in group.gr_mem:
        return "Your account needs to be in the input group (it asks for your password)."
    if group.gr_gid not in os.getgroups():
        return "Log out and back in to finish turning it on."
    return None


def set_ptt(on):
    """Starts or stops skornex-ptt now and at login. Stopping it unmutes the mic."""
    subprocess.run(["pkill", "-f", r"\.local/bin/skornex-ptt$"])
    if not on:
        if os.path.exists(PTT_AUTOSTART):
            os.remove(PTT_AUTOSTART)
        # skornex-ptt unmutes what it muted, but a mic that was unplugged then
        # comes back muted later: so every microphone is unmuted here too.
        for mic in pactl_json("list", "sources"):
            if not mic["name"].endswith(".monitor"):
                pactl("set-source-mute", mic["name"], "0")
        return
    os.makedirs(os.path.dirname(PTT_AUTOSTART), exist_ok=True)
    with open(PTT_AUTOSTART, "w") as f:
        f.write("#!/bin/sh\n# Made by Sound settings: push to talk (skornex-ptt).\n"
                f"exec {PTT} >> ~/.cache/skornex-ptt.log 2>&1\n")
    os.chmod(PTT_AUTOSTART, 0o755)
    user = os.environ.get("USER") or os.getlogin()
    try:
        in_group = user in grp.getgrnam("input").gr_mem
    except KeyError:
        in_group = True
    if not in_group and shutil.which("pkexec"):
        subprocess.run(["pkexec", "usermod", "-aG", "input", user])
    subprocess.Popen(["sh", PTT_AUTOSTART], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def heading(text):
    label = Gtk.Label(xalign=0)
    label.set_markup(f"<b>{GLib.markup_escape_text(text)}</b>")
    label.set_margin_top(8)
    return label


class Page(Gtk.Box):
    def __init__(self):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.set_border_width(24)
        self.state = load_state()
        self.old_cap_loaded = False
        self.loading = False
        self.dragging = False
        title = Gtk.Label(xalign=0)
        title.set_markup(f"<span size='x-large' weight='bold'>{TITLE}</span>")
        self.pack_start(title, False, False, 0)

        self.pack_start(heading("Output (speakers, headphones)"), False, False, 0)
        self.out_combo = Gtk.ComboBoxText()
        self.out_combo.connect("changed", lambda c: not self.loading and c.get_active_id()
                               and (pactl("set-default-sink", c.get_active_id()), self.load()))
        self.pack_start(self.out_combo, False, False, 0)
        self.out_volume, self.out_mute = self.volume_row(
            "sink", lambda: "@DEFAULT_SINK@", 100)

        self.pack_start(heading("Microphone"), False, False, 0)
        self.in_combo = Gtk.ComboBoxText()
        self.in_combo.connect("changed", lambda c: not self.loading and c.get_active_id()
                              and self.choose_mic(c.get_active_id()))
        self.pack_start(self.in_combo, False, False, 0)
        self.in_volume, self.in_mute = self.volume_row("source", self.mic, 150)
        self.in_volume.add_mark(100, Gtk.PositionType.BOTTOM, "100%")

        only_row = Gtk.Box(spacing=12)
        only_row.pack_start(Gtk.Label(label="Only use this microphone", xalign=0), False, False, 0)
        self.only_switch = Gtk.Switch(active=self.state["only_mic"], valign=Gtk.Align.CENTER)
        self.only_switch.connect("notify::active", lambda w, _p: self.set_only_mic(w.get_active()))
        only_row.pack_start(self.only_switch, False, False, 0)
        self.pack_start(only_row, False, False, 0)
        only_about = Gtk.Label(xalign=0, wrap=True, max_width_chars=70)
        only_about.set_text("Turns your other microphones off (like the webcam's), so apps never switch "
                            "to them when this one is unplugged. They pick it up again when it's back.")
        only_about.set_opacity(0.7)
        self.pack_start(only_about, False, False, 0)

        cap_row = Gtk.Box(spacing=12)
        cap_row.pack_start(Gtk.Label(label="Cap how loud you can get", xalign=0), False, False, 0)
        self.cap_switch = Gtk.Switch(active=self.state["cap"], valign=Gtk.Align.CENTER)
        cap_row.pack_start(self.cap_switch, False, False, 0)
        self.pack_start(cap_row, False, False, 0)
        # The cap level, like OBS's limiter: the white line on the meter
        # below. Drag it; nothing you say gets past it.
        self.cap_db = float(self.state["limit"])
        self.cap_note = Gtk.Label(xalign=0, wrap=True)  # only for problems
        self.cap_note.set_no_show_all(True)
        self.pack_start(self.cap_note, False, False, 0)
        self.cap_switch.connect("notify::active", lambda *_: (self.meter.queue_draw(), self.apply_cap()))

        test_row = Gtk.Box(spacing=10)
        test_row.pack_start(Gtk.Label(label="Test"), False, False, 0)
        self.meter = Gtk.DrawingArea()
        self.meter.set_size_request(-1, 22)
        self.meter.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK
                              | Gdk.EventMask.BUTTON1_MOTION_MASK)
        self.meter.connect("button-press-event", self.drag_cap)
        self.meter.connect("motion-notify-event", self.drag_cap)
        self.meter.connect("button-release-event", lambda *_: self.cap_switch.get_active()
                           and GLib.idle_add(self.apply_cap, True) and False)
        self.meter.set_hexpand(True)
        self.meter.set_valign(Gtk.Align.CENTER)
        self.meter.connect("draw", self.draw_meter)
        test_row.pack_start(self.meter, True, True, 0)
        self.record_button = Gtk.Button(label=f"Record {TEST_SECONDS} seconds and play back")
        self.record_button.connect("clicked", lambda _b: self.record_test())
        test_row.pack_start(self.record_button, False, False, 0)
        self.pack_start(test_row, False, False, 0)

        self.pack_start(heading("Push to talk"), False, False, 0)
        grid = Gtk.Grid(row_spacing=10, column_spacing=24)
        self.pack_start(grid, False, False, 0)
        grid.attach(Gtk.Label(label="Mute the mic until you hold a key", xalign=0), 0, 0, 1, 1)
        ptt = Gtk.Switch(active=self.state["ptt"], halign=Gtk.Align.START)
        ptt.connect("notify::active", lambda w, _p: self.set_ptt(ptt=w.get_active()))
        grid.attach(ptt, 1, 0, 1, 1)
        grid.attach(Gtk.Label(label="Key to hold", xalign=0), 0, 1, 1, 1)
        self.ptt_key = Gtk.Button(label=self.state["ptt_name"], halign=Gtk.Align.START)
        self.ptt_key.connect("clicked", lambda _b: self.pick_key())
        self.ptt_key.connect("key-press-event", self.on_pick_key)
        self.ptt_key.connect("button-press-event", self.on_pick_button)
        grid.attach(self.ptt_key, 1, 1, 1, 1)
        self.picking = False
        about = Gtk.Label(xalign=0, wrap=True, max_width_chars=70)
        about.set_text("Works in every app, even in games. In TeamSpeak and Discord, use Voice "
                       "Activation instead of their own push to talk. To change the key, click it, "
                       "then press a key or mouse side button. The key keeps its usual job: Caps "
                       "Lock still switches capitals.")
        about.set_opacity(0.7)
        self.pack_start(about, False, False, 0)
        self.ptt_status = Gtk.Label(xalign=0, wrap=True, max_width_chars=70)
        self.ptt_status.set_no_show_all(True)
        self.pack_start(self.ptt_status, False, False, 0)
        self.show_ptt_status()

        self.pack_start(heading("Apps"), False, False, 0)
        self.apps = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        self.pack_start(self.apps, False, False, 0)

        self.meter_proc = None
        self.level = 0.0
        self.load()
        # Apps start and stop playing; keep the list fresh while it's open.
        self.timer = GLib.timeout_add_seconds(2, self.refresh_apps)
        self.connect("map", lambda *_: self.start_meter())
        self.connect("unmap", lambda *_: self.stop_meter())
        self.connect("destroy", lambda *_: (GLib.source_remove(self.timer), self.stop_meter()))

    # Push to talk. Picking the key: click the button, then press a key or a
    # mouse button. Escape cancels.
    def set_ptt(self, ptt=None, key=None, name=None):
        if ptt is not None:
            self.state["ptt"] = ptt
        if key:
            self.state["ptt_key"], self.state["ptt_name"] = key, name
        save_state(self.state)
        if ptt is not None or self.state["ptt"]:
            set_ptt(self.state["ptt"])   # a new key needs a restart
        self.show_ptt_status()
        GLib.timeout_add(500, lambda: self.load() and False)   # the mic's mute button

    def show_ptt_status(self):
        problem = ptt_problem() if self.state["ptt"] else None
        self.ptt_status.set_text(problem or "")
        self.ptt_status.set_visible(bool(problem))

    def pick_key(self):
        if self.picking:
            return
        self.picking = True
        self.ptt_key.set_label("Press a key or mouse button… (Esc cancels)")
        self.ptt_key.grab_focus()

    def done_picking(self, key=None, name=None):
        self.picking = False
        if key:
            self.set_ptt(key=key, name=name)
        self.ptt_key.set_label(self.state["ptt_name"])

    def on_pick_key(self, _w, event):
        if not self.picking:
            return False
        if event.keyval == Gdk.KEY_Escape:
            self.done_picking()
            return True
        key = key_names().get(event.hardware_keycode - 8)   # X keycodes are Linux's + 8
        if key:
            self.done_picking(key, key_label(key, event.keyval))
        return True

    def on_pick_button(self, _w, event):
        if not self.picking or event.type != Gdk.EventType.BUTTON_PRESS:
            return False
        if event.button in MOUSE_BUTTONS:
            self.done_picking(*MOUSE_BUTTONS[event.button])
            return True
        return False   # a left click on the button just keeps waiting

    def volume_row(self, kind, target, top):
        row = Gtk.Box(spacing=8)
        mute = Gtk.ToggleButton()
        mute.set_tooltip_text("Mute")
        scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, top, 1)
        scale.set_hexpand(True)
        scale.set_value_pos(Gtk.PositionType.RIGHT)
        scale.connect("value-changed", lambda s: not self.loading and pactl(
            f"set-{kind}-volume", target(), f"{int(s.get_value())}%"))
        mute.connect("toggled", lambda b: (self.set_mute_icon(b), not self.loading and pactl(
            f"set-{kind}-mute", target(), "1" if b.get_active() else "0")))
        row.pack_start(mute, False, False, 0)
        row.pack_start(scale, True, True, 0)
        self.pack_start(row, False, False, 0)
        return scale, mute

    @staticmethod
    def set_mute_icon(button):
        name = "audio-volume-muted-symbolic" if button.get_active() else "audio-volume-high-symbolic"
        button.set_image(Gtk.Image.new_from_icon_name(name, Gtk.IconSize.BUTTON))

    # --- Devices ---

    def mic(self):
        """The real microphone (while capped, apps use the capped copy of it)."""
        default = pactl("get-default-source").strip()
        if default == CAP_NODE and self.state["mic"]:
            return self.state["mic"]
        return default

    def fill(self, combo, scale, mute, devices, current_name):
        combo.remove_all()
        for d in devices:
            combo.append(d["name"], d.get("description") or d["name"])
        combo.set_active_id(current_name)
        current = next((d for d in devices if d["name"] == current_name), None)
        scale.set_sensitive(current is not None)
        mute.set_sensitive(current is not None)
        if current:
            scale.set_value(percent(current))
            mute.set_active(bool(current.get("mute")))
        self.set_mute_icon(mute)

    def load(self):
        self.loading = True
        sinks = pactl_json("list", "sinks")
        self.fill(self.out_combo, self.out_volume, self.out_mute, sinks, pactl("get-default-sink").strip())
        # Real microphones only: not the speakers' "monitor" echo, not the capped copy.
        mics = [d for d in pactl_json("list", "sources")
                if not d["name"].endswith(".monitor") and d["name"] != CAP_NODE]
        self.fill(self.in_combo, self.in_volume, self.in_mute, mics, self.mic())
        self.loading = False
        self.app_ids = None
        self.refresh_apps()

    def set_only_mic(self, on):
        if self.loading:
            return
        self.state["only_mic"] = on
        if on:
            self.state["mic"] = self.mic()
        only_use_mic(self.state, self.state["mic"] if on else None)
        save_state(self.state)
        GLib.timeout_add(800, lambda: (self.load(), self.start_meter(), False)[-1])

    def choose_mic(self, name):
        self.state["mic"] = name
        save_state(self.state)
        if self.state["only_mic"]:
            only_use_mic(self.state, name)
        if self.state["cap"]:
            self.apply_cap()  # point the cap at the new microphone
        else:
            pactl("set-default-source", name)
            self.load()
            self.start_meter()

    # --- The cap (a limiter in PipeWire) ---

    def apply_cap(self, level_only=False):
        """Turns the cap on or off, or (level_only, after dragging the cap
        line) just changes its level. Nothing else in the sound system is
        restarted, so apps keep their sound."""
        self.state["cap"] = self.cap_switch.get_active()
        self.state["limit"] = self.cap_db
        if self.state["cap"] and not level_only:
            self.state["mic"] = self.mic()
        save_state(self.state)
        if os.path.exists(OLD_CAP_CONF):
            os.remove(OLD_CAP_CONF)   # from an earlier version; gone after the next login
            # Still running inside PipeWire if its microphone is there but
            # no cap process of ours is.
            ours = subprocess.run(["pgrep", "-f", CAP_PROCESS], capture_output=True).returncode == 0
            self.old_cap_loaded = not ours and CAP_NODE in pactl("list", "short", "sources")
        if not self.state["cap"]:
            stop_cap()
            if self.state["mic"]:
                pactl("set-default-source", self.state["mic"])
            GLib.timeout_add(500, lambda: (self.load(), self.start_meter(), False)[-1])
            return False
        if not os.path.exists("/usr/lib/ladspa/fast_lookahead_limiter_1913.so"):
            self.cap_note.set_text("The cap needs swh-plugins. Run: sudo pacman -S swh-plugins")
            self.cap_note.show()
            return False
        os.makedirs(os.path.dirname(CAP_CONF), exist_ok=True)
        with open(CAP_CONF, "w") as f:   # also what it starts with at the next login
            f.write(CAP_TEMPLATE.format(node=CAP_NODE, mic=self.state["mic"],
                                        **cap_settings(self.state["limit"])))
        if level_only and set_cap_live(self.state["limit"]):
            return False
        self.stop_meter()
        self.set_sensitive(False)
        if self.old_cap_loaded:
            # An earlier version's cap is still running inside PipeWire until
            # the next login; starting another now would make two. So only
            # set it up for the next login, and use the running one until then.
            start_cap(now=False)
        else:
            start_cap()
        GLib.timeout_add(500, self.after_restart)
        return False

    def after_restart(self, tries=0):
        """Waits for the cap's microphone to appear, then makes it the default."""
        names = [d["name"] for d in pactl_json("list", "sources")]
        want = CAP_NODE if self.state["cap"] else self.state["mic"]
        if want not in names and tries < 20:
            GLib.timeout_add(500, self.after_restart, tries + 1)
            return False
        if want in names:
            pactl("set-default-source", want)
            self.cap_note.hide()
        elif self.state["cap"]:
            self.cap_note.set_text("Couldn't turn on the cap.")
            self.cap_note.show()
        self.set_sensitive(True)
        self.load()
        self.start_meter()
        return False

    # --- Testing: a live level meter, and record + play back ---

    def start_meter(self):
        self.stop_meter()
        self.cancel = Gio.Cancellable()
        try:
            self.meter_proc = Gio.Subprocess.new(
                ["parec", "--raw", "--format=s16le", "--channels=1", "--rate=16000",
                 "--latency-msec=50", "-d", "@DEFAULT_SOURCE@"],
                Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_SILENCE)
        except GLib.Error:
            self.meter_proc = None
            return
        self.read_meter(self.meter_proc.get_stdout_pipe())

    def read_meter(self, stream):
        stream.read_bytes_async(1600, GLib.PRIORITY_DEFAULT, self.cancel, self.on_meter)

    def on_meter(self, stream, result):
        try:
            data = stream.read_bytes_finish(result).get_data()
        except GLib.Error:
            return
        if not data:
            return
        samples = array.array("h")
        samples.frombytes(data[:len(data) // 2 * 2])
        peak = max((abs(x) for x in samples), default=0) / 32768
        level = max(0.0, min(1.0, (20 * math.log10(peak) + 60) / 60)) if peak > 0 else 0.0
        self.level = max(level, self.level - 0.06)  # rises fast, falls slowly
        self.meter.queue_draw()
        self.read_meter(stream)

    def stop_meter(self):
        if self.meter_proc:
            self.cancel.cancel()
            self.meter_proc.force_exit()
            self.meter_proc = None
        self.level = 0.0
        self.meter.queue_draw()

    def drag_cap(self, widget, event):
        """Moves the cap line (only while the cap is on)."""
        if not self.cap_switch.get_active():
            return False
        db = event.x / max(1, widget.get_allocated_width()) * 60 - 60
        self.cap_db = float(round(max(LOWEST_CAP, min(-1, db))))
        widget.queue_draw()
        return True

    def draw_meter(self, widget, cr):
        """-60 dB on the left, 0 dB on the right; the line is the cap."""
        w, h = widget.get_allocated_width(), widget.get_allocated_height()
        cr.set_source_rgba(1, 1, 1, 0.08)
        cr.rectangle(0, 0, w, h)
        cr.fill()
        cap = (self.cap_db + 60) / 60
        loud = self.cap_switch.get_active() and self.level >= cap - 0.01
        cr.set_source_rgb(0.9, 0.6, 0.2) if loud else cr.set_source_rgb(0.3, 0.75, 0.45)
        cr.rectangle(0, 0, w * self.level, h)
        cr.fill()
        if self.cap_switch.get_active():
            x = int(w * cap)
            cr.set_source_rgb(0.95, 0.95, 0.95)
            cr.rectangle(x - 1, 0, 3, h)  # the line, with a grip you can drag
            cr.fill()
            text = f"{self.cap_db:.0f} dB"
            cr.set_font_size(11)
            ext = cr.text_extents(text)
            cr.move_to(min(x + 6, w - ext.width - 4), h / 2 + ext.height / 2)
            cr.show_text(text)
        return False

    def record_test(self):
        path = os.path.join(tempfile.gettempdir(), f"skornex-mic-test-{os.getpid()}.wav")
        script = (f'parecord --file-format=wav -d @DEFAULT_SOURCE@ "$1" & p=$!; sleep {TEST_SECONDS}; '
                  'kill $p; wait $p; paplay "$1"; rm -f "$1"')
        try:
            proc = Gio.Subprocess.new(["sh", "-c", script, "sh", path], Gio.SubprocessFlags.NONE)
        except GLib.Error:
            return
        self.record_button.set_sensitive(False)
        left = [TEST_SECONDS]

        def tick():
            if left[0] > 0:
                self.record_button.set_label(f"Recording… talk now ({left[0]})")
                left[0] -= 1
                return True
            self.record_button.set_label("Playing it back…")
            return False
        tick()
        GLib.timeout_add_seconds(1, tick)
        proc.wait_async(None, lambda *_: (self.record_button.set_label(
            f"Record {TEST_SECONDS} seconds and play back"), self.record_button.set_sensitive(True)))

    def refresh_apps(self):
        if self.dragging:
            return True
        streams = pactl_json("list", "sink-inputs")
        ids = [st["index"] for st in streams]
        if ids == getattr(self, "app_ids", None):
            return True  # same apps as before: leave the sliders alone
        self.app_ids = ids
        for child in self.apps.get_children():
            child.destroy()
        if not streams:
            note = Gtk.Label(label="No apps are playing sound right now.", xalign=0)
            note.get_style_context().add_class("dim-label")
            self.apps.pack_start(note, False, False, 0)
        for s in streams:
            props = s.get("properties", {})
            name = props.get("application.name") or props.get("media.name") or "App"
            row = Gtk.Box(spacing=8)
            icon = Gtk.Image.new_from_icon_name(props.get("application.icon_name") or "audio-x-generic",
                                                Gtk.IconSize.LARGE_TOOLBAR)
            label = Gtk.Label(label=name, xalign=0, width_chars=18, max_width_chars=18)
            label.set_ellipsize(3)  # Pango.EllipsizeMode.END
            scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
            scale.set_value(percent(s))
            scale.set_hexpand(True)
            scale.set_value_pos(Gtk.PositionType.RIGHT)
            scale.connect("value-changed", lambda sc, i=s["index"]: pactl(
                "set-sink-input-volume", str(i), f"{int(sc.get_value())}%"))
            # Don't rebuild the list under the mouse while a slider is dragged.
            scale.connect("button-press-event", lambda *_: setattr(self, "dragging", True))
            scale.connect("button-release-event", lambda *_: setattr(self, "dragging", False))
            row.pack_start(icon, False, False, 0)
            row.pack_start(label, False, False, 0)
            row.pack_start(scale, True, True, 0)
            self.apps.pack_start(row, False, False, 0)
        self.apps.show_all()
        return True


def main():
    GLib.set_prgname(APP_ID)
    app = Gtk.Application(application_id=APP_ID)

    def activate(app):
        if app.get_windows():
            app.get_windows()[0].present()
            return
        Gtk.Settings.get_default().props.gtk_application_prefer_dark_theme = True
        window = Gtk.ApplicationWindow(application=app, title=f"{TITLE} settings")
        window.set_default_size(640, 560)
        window.set_icon_name(ICON)
        scroller = Gtk.ScrolledWindow()
        scroller.add(Page())
        window.add(scroller)
        # Ctrl+W closes it, like most windows.
        close = Gio.SimpleAction.new("close", None)
        close.connect("activate", lambda *_: window.close())
        window.add_action(close)
        app.set_accels_for_action("win.close", ["<Ctrl>w"])
        window.show_all()
    app.connect("activate", activate)
    sys.exit(app.run(sys.argv))


if __name__ == "__main__":
    main()
