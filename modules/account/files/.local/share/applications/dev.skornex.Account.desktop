[Desktop Entry]
# SkorneX Settings module (account). Named after the window's app ID so the
# taskbar and title bar find its icon.
Type=Application
Name=Account
Comment=Your user name, and changing your password.
Exec=skornex-account
Icon=system-users
StartupWMClass=dev.skornex.Account
Categories=Settings;
Keywords=account;user;password;sign-in;login;
