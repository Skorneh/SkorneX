#!/usr/bin/env bash
# skornex-screenshot region  drag a box, copy to clipboard
# skornex-screenshot full    whole screen, copy to clipboard
# skornex-screenshot window  the window you're using, copy to clipboard
# skornex-screenshot save    whole screen, saved to ~/Pictures/Screenshots
# Cuts the empty (transparent or pure black) strips off the edges of a window
# capture: some apps (LibreWolf) come with them.
trim() {
    python3 - "$1" <<'EOF'
import sys
import gi
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import GdkPixbuf

path = sys.argv[1]
pix = GdkPixbuf.Pixbuf.new_from_file(path)
w, h, n, stride = pix.get_width(), pix.get_height(), pix.get_n_channels(), pix.get_rowstride()
data = pix.get_pixels()
black = b"\0\0\0\xff" if n == 4 else b"\0\0\0"


def empty(pixels, count):
    """pixels: count pixels, n bytes each."""
    if n == 4 and pixels[3::4] == bytes(count):
        return True
    return pixels == black * count


def row(y, x0, x1):
    return data[y * stride + x0 * n: y * stride + x1 * n]


def col(x, y0, y1):
    return b"".join(data[y * stride + x * n: y * stride + x * n + n] for y in range(y0, y1))


top, bottom, left, right = 0, h, 0, w
while top < bottom - 1 and empty(row(top, left, right), right - left):
    top += 1
while bottom - 1 > top and empty(row(bottom - 1, left, right), right - left):
    bottom -= 1
while left < right - 1 and empty(col(left, top, bottom), bottom - top):
    left += 1
while right - 1 > left and empty(col(right - 1, top, bottom), bottom - top):
    right -= 1
if (top, bottom, left, right) != (0, h, 0, w):
    pix.new_subpixbuf(left, top, right - left, bottom - top).savev(path, "png", [], [])
EOF
}

case "${1:-region}" in
    region)
        area="$(slurp)" || exit 0
        grim -g "$area" - | wl-copy --type image/png
        notify-send -t 2000 "Screenshot" "Copied to clipboard" ;;
    full)
        grim - | wl-copy --type image/png
        notify-send -t 2000 "Screenshot" "Copied to clipboard" ;;
    window)
        # grim captures one window by its ID (-T). lswt lists the IDs; the
        # active window's app and title come from the same library the
        # taskbar uses, and pick which ID is the active one.
        id="$(python3 - <<'EOF'
import json, re, subprocess, time
import gi
gi.require_version("Libxfce4windowing", "0.0")
from gi.repository import GLib, Libxfce4windowing as Xfw

screen = Xfw.Screen.get_default()
ctx = GLib.MainContext.default()
end = time.monotonic() + 1
while screen.get_active_window() is None and time.monotonic() < end:
    ctx.iteration(False)
    time.sleep(0.01)
active = screen.get_active_window()
if active is None:
    raise SystemExit
title = active.get_name() or ""
apps = set(active.get_class_ids() or [])


def toplevels(data):
    """Every window lswt lists, whatever the JSON nesting."""
    if isinstance(data, dict):
        if any("ident" in k for k in data):
            yield data
        for value in data.values():
            yield from toplevels(value)
    elif isinstance(data, list):
        for value in data:
            yield from toplevels(value)


def field(top, word):
    return next((v for k, v in top.items() if word in k.lower()), None)


for args in (["lswt", "-j"], ["lswt", "-j", "--force-protocol", "ext-foreign-toplevel-list-v1"]):
    try:
        out = subprocess.run(args, capture_output=True, text=True, timeout=3).stdout
        # lswt prints the identifiers without quotes, which isn't valid JSON.
        out = re.sub(r'("identifier"\s*:\s*)([^",\s}]+)', r'\1"\2"', out)
        data = json.loads(out)
    except (OSError, ValueError, subprocess.SubprocessError):
        continue
    tops = list(toplevels(data))
    found = [t for t in tops if field(t, "title") == title and field(t, "app") in apps] \
        or [t for t in tops if field(t, "title") == title]
    if found:
        print(field(found[0], "ident"))
        break
EOF
)"
        shot="$(mktemp --suffix=.png)"
        trap 'rm -f "$shot"' EXIT
        if [[ -n "$id" ]] && grim -T "$id" "$shot" && trim "$shot" && wl-copy --type image/png <"$shot"; then
            notify-send -t 2000 "Screenshot" "Window copied to clipboard"
        else
            # No window capture here: drag a box instead.
            rm -f "$shot"; exec "$0" region
        fi ;;
    save)
        dir="$HOME/Pictures/Screenshots"
        mkdir -p "$dir"
        file="$dir/Screenshot_$(date +%Y-%m-%d_%H-%M-%S).png"
        grim "$file" && notify-send -t 3000 "Screenshot" "Saved to $file" ;;
esac
